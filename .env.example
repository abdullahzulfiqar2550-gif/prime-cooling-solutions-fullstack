# =============================================================================
# Prime Cooling Solutions — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# === Database (PostgreSQL) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=primecooling_db
POSTGRES_USER=primecooling
POSTGRES_PASSWORD=changeme_secure_password

# === Backend Security ===
SECRET_KEY=changeme_generate_a_64_character_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:3000

# === Initial Admin Account ===
ADMIN_EMAIL=admin@primecooling.pk
ADMIN_PASSWORD=changeme_admin_password
ADMIN_NAME=Zubair Akeel

# === SMTP Email (Optional — logs to console if not configured) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=primecoolingsolutions.pk@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=primecoolingsolutions.pk@gmail.com
SMTP_FROM_NAME=Prime Cooling Solutions

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WHATSAPP_NUMBER=923371768618
NEXT_PUBLIC_PHONE_NUMBER=03371768618
NEXT_PUBLIC_COMPANY_EMAIL=primecoolingsolutions.pk@gmail.com
